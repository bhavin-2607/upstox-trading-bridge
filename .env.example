# ==============================================================================
# UPSTOX API CREDENTIALS
# Obtain from https://developer.upstox.com
# ==============================================================================
UPSTOX_API_KEY="your_api_key_here"
UPSTOX_API_SECRET="your_api_secret_here"
UPSTOX_REDIRECT_URI="http://127.0.0.1:5000/callback"

# Optional: If you already generated today's access token manually, paste it here.
# Otherwise, leave blank and run `python main.py login`
UPSTOX_ACCESS_TOKEN=""

# ==============================================================================
# GOOGLE SHEETS WEBHOOK (Zero Google Cloud Account Needed!)
# Deploy the provided scripts/google_apps_script.js in your Google Sheet (Extensions > Apps Script > Deploy > Web app)
# ==============================================================================
GOOGLE_SHEET_WEBHOOK_URL=""

# ==============================================================================
# OPTIONAL: HEADLESS TOTP AUTO-LOGIN (Leave empty for interactive browser login)
# ==============================================================================
UPSTOX_MOBILE_NO=""
UPSTOX_PIN=""
UPSTOX_TOTP_KEY=""
